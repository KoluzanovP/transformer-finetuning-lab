# Copy this file to `.env` and adjust as needed.

# Hugging Face model + dataset
MODEL_NAME=distilbert-base-uncased
DATASET_NAME=emotion
NUM_LABELS=6
MAX_SEQ_LENGTH=128

# Training hyper-parameters
LEARNING_RATE=2e-5
BATCH_SIZE=32
NUM_EPOCHS=3
WEIGHT_DECAY=0.01
WARMUP_RATIO=0.1
SEED=42

# Output / logging
OUTPUT_DIR=./artifacts
LOGGING_DIR=./runs

# Serving
MODEL_DIR=./artifacts/full_finetune
API_HOST=0.0.0.0
API_PORT=8000
