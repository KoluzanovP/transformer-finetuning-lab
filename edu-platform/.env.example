# ---- Database ----
DATABASE_URL="postgresql://edu:edu@localhost:5432/edu_platform?schema=public"

# ---- API ----
API_PORT=4000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- OAuth (заглушки для будущей интеграции) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
OAUTH_CALLBACK_BASE="http://localhost:4000"

# ---- Media storage (S3 / Cloudflare R2) ----
# Для локальной разработки используется файловая заглушка (LOCAL).
STORAGE_DRIVER="LOCAL"            # LOCAL | S3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="edu-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"
