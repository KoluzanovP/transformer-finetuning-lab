# Скопируйте в .env рядом с docker-compose.prod.yml и заполните.

# ---- PostgreSQL (контейнер db) ----
POSTGRES_USER=edu
POSTGRES_PASSWORD=ЗАМЕНИТЕ_надёжный_пароль
POSTGRES_DB=edu_platform

# DATABASE_URL для API.
# Вариант А — БД в контейнере (по умолчанию):
DATABASE_URL=postgresql://edu:ЗАМЕНИТЕ_надёжный_пароль@db:5432/edu_platform?schema=public
# Вариант Б — управляемая БД Timeweb Cloud: подставьте строку подключения из панели
# и удалите сервис db из docker-compose.prod.yml, например:
# DATABASE_URL=postgresql://user:pass@host.timeweb.cloud:5432/dbname?schema=public&sslmode=require

# ---- Секреты JWT (сгенерируйте: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=ЗАМЕНИТЕ_32+_символа
JWT_REFRESH_SECRET=ЗАМЕНИТЕ_другой_32+_символа
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Домен ----
# Разрешённый origin фронтенда (для CORS). Укажите ваш домен со схемой.
WEB_ORIGIN=https://edu.ваш-домен.ru
# Публичный адрес API для браузера. Пусто = тот же домен (рекомендуется, всё за nginx).
NEXT_PUBLIC_API_URL=

# ---- Хранилище медиа ----
# LOCAL — файлы на диске сервера (том uploads). Для масштаба — S3 (Timeweb S3).
STORAGE_DRIVER=LOCAL
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Первый администратор (создаётся при старте, удобно для Timeweb Apps) ----
# После первого входа переменные можно убрать.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Админ
BOOTSTRAP_ADMIN_LAST_NAME=Платформы

# ---- OAuth (необязательно) ----
OAUTH_CALLBACK_BASE=https://edu.ваш-домен.ru
OAUTH_SUCCESS_REDIRECT=https://edu.ваш-домен.ru/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
